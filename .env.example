# Copy to .env and fill locally. Never commit .env.

FLOW_BASE_URL="https://flow.team"

# Option A: set session values directly.
FLOW_USER_ID=""
FLOW_RGSN_DTTM=""

# Option B: import a HAR once and store the session here.
FLOW_SESSION_PATH="~/.flow-mcp/session.json"

# Optional default used by flow_list_today_schedules when colabo_srno is omitted.
FLOW_DEFAULT_SCHEDULE_PROJECT_TITLE="일정 공유"
